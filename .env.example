# Server Configuration
PORT=3000
HOST=0.0.0.0

# Database Configuration
DATABASE_URL="postgresql://gaujofit_user:gaujofit_password@localhost:5433/gaujofit_db?schema=public"

# PostgreSQL Configuration
POSTGRES_USER=gaujofit_user
POSTGRES_PASSWORD=gaujofit_password
POSTGRES_DB=gaujofit_db

# Google OAuth Configuration
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Session Secret (change this to a random string in production)
SESSION_SECRET=your-secret-key-change-this-in-production

# Email Configuration
# Set to "true" to disable actual email sending (useful in tests/CI)
DISABLE_EMAIL=true

# RESEND_API_KEY=your_resend_api_key_here
# OpenTelemetry & Grafana Logs Configuration
SERVICE_NAME=gaujofit-service
SERVICE_VERSION=1.0.0
NODE_ENV=development


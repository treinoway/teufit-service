# Server Configuration
PORT=3000
HOST=0.0.0.0

# Database Configuration (must match docker-compose POSTGRES_* vars)
DATABASE_URL="postgresql://treinoway_user:treinoway_password@localhost:5433/treinoway_db?schema=public"

# PostgreSQL Configuration (used by docker-compose)
POSTGRES_USER=treinoway_user
POSTGRES_PASSWORD=treinoway_password
POSTGRES_DB=treinoway_db

# Google OAuth Configuration
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Sign in with Apple (mobile native) — allowed audience(s) for the identityToken `aud`.
# Set per environment in Railway. Single bundle id, or comma-separated to accept many.
#   HML:  br.com.teufit.app.stg
#   PROD: treinoway.com.br.treinoway
# (Apple Team ID 68SXP4977P is not used for mobile JWT validation.)
APPLE_BUNDLE_ID=br.com.teufit.app.stg

# Firebase Configuration (used for web Google Sign-In via Firebase Auth)
FIREBASE_PROJECT_ID=your_firebase_project_id_here

# Session Secret (change this to a random string in production)
SESSION_SECRET=your-secret-key-change-this-in-production

# Email Configuration
# Set to disable actual email sending (useful in tests/CI). Accepts
# true/false, 1/0, yes/no, on/off — case-insensitive, whitespace-trimmed.
# Unset/empty/unrecognized defaults to false (email enabled).
DISABLE_EMAIL=true

# RESEND_API_KEY=your_resend_api_key_here

# S3 Configuration (Railway S3-compatible storage)
# Set to disable S3 uploads (useful in tests/CI). Same accepted values as
# DISABLE_EMAIL above. Unset/empty/unrecognized defaults to false (uploads enabled).
DISABLE_S3_UPLOAD=false

# AWS S3 credentials (Railway provides S3-compatible API)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_railway_s3_access_key
AWS_SECRET_ACCESS_KEY=your_railway_s3_secret_key
AWS_S3_BUCKET_NAME=your_railway_bucket_name
AWS_ENDPOINT_URL=https://your-railway-s3-endpoint.railway.app

# AI Assistant Configuration
LLM_PROVIDER=anthropic  # anthropic | gemini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Emergency kill-switch for the /become-trainer closed-beta invite gate — set to
# disable the gate without a deploy. Accepts true/false, 1/0, yes/no, on/off —
# case-insensitive, whitespace-trimmed (so "FALSE", "0", " false" all work as
# expected). Unset/empty/unrecognized defaults to true (gate enabled).
# BETA_INVITE_GATE_ENABLED=false

# Comma-separated allowlist of emails that bypass the closed-beta invite gate for
# testing (QA/testers get betaAccess:true from GET /me and can hit
# PATCH /become-trainer without redeeming an invite code). Matched case-insensitively.
# Example: BETA_TESTER_EMAILS=qa1@treinoway.com.br,qa2@treinoway.com.br
BETA_TESTER_EMAILS=

# Asaas Billing (platform SaaS subscriptions) — not yet integrated in production/staging.
ASAAS_API_KEY=
# REQUIRED once ASAAS_API_KEY is set in production or staging (i.e. once Asaas is
# actually live there). The /webhooks/asaas route validates every incoming request
# against this value; buildServer() refuses to start when ASAAS_API_KEY is
# configured in production/staging but this is empty (see
# assertAsaasWebhookSecretConfigured in src/helpers/asaas-webhook-helpers.js) —
# without it, anyone could POST a forged PAYMENT_CONFIRMED event and upgrade a
# trainer's tier for free. Not required in development/test, even with a sandbox
# ASAAS_API_KEY configured locally.
ASAAS_WEBHOOK_SECRET=
ASAAS_ENV=sandbox

# Sentry error aggregation + tracing (optional — all Sentry calls are no-ops when SENTRY_DSN is absent)
# Set SENTRY_DSN to enable. SENTRY_ENVIRONMENT defaults to 'beta'.
# Init runs in the ./instrument.js preload (node --import ./instrument.js) so OTel can
# trace http/pg/fastify. SENTRY_TRACES_SAMPLE_RATE = fraction of requests traced (0..1):
#   staging: 1.0 (full traces)   prod: 0.1 (default, sampled)   disable: 0
# SENTRY_DSN=https://your-dsn@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=beta
# SENTRY_TRACES_SAMPLE_RATE=1.0

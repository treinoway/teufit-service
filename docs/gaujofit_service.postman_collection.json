{
  "info": {
    "name": "Gaujofit Service API",
    "_postman_id": "00000000-0000-0000-0000-000000000000",
    "description": "Postman collection for gaujofit_service (Fastify + Prisma).\n\nNotes:\n- This API uses cookie-based sessions. For authenticated calls, either run the OAuth flow in a browser and copy the session cookie into Postman, or use the OAuth endpoints in Postman and let it store cookies automatically (requires a valid Google OAuth Client configured for your callback URL).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup (email + password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new_trainer@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            }
          },
          "description": "Creates a new trainer user using email + password and stores the user in the session cookie. After this, you can call protected endpoints like GET /me or PATCH /trainer/."
        },
        {
          "name": "Login (email + password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new_trainer@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "description": "Logs in an existing email/password user and stores the user in the session cookie."
        },
        {
          "name": "Start Google OAuth w/ role (trainer)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/trainer/google",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "trainer", "google"]
            }
          }
        },
        {
          "name": "OAuth Callback (Google)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/google/callback",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "google", "callback"]
            }
          },
          "description": "Completes the Google OAuth flow, stores the user in the session cookie, and redirects the browser to your frontend (FRONTEND_REDIRECT_URL/FRONTEND_URL)."
        },
        {
          "name": "Logout",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Trainer",
      "item": [
        {
          "name": "Get My Trainer Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": ["{{baseUrl}}"],
              "path": ["me"]
            }
          },
          "description": "Requires auth via session cookie (created by POST /auth/signup, POST /auth/login, or Google OAuth). Returns a flattened trainer payload."
        },
        {
          "name": "Update User Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"João\",\n  \"lastName\": \"Silva\",\n  \"gender\": \"male\",\n  \"birthDate\": \"1990-05-15\",\n  \"avatarUrl\": \"https://example.com/avatar.jpg\",\n  \"address\": {\n    \"line1\": \"Avenida Paulista, 1000\",\n    \"line2\": \"Apt 101\",\n    \"neighborhood\": \"Bela Vista\",\n    \"city\": \"São Paulo\",\n    \"state\": \"São Paulo\",\n    \"stateCode\": \"SP\",\n    \"country\": \"Brasil\",\n    \"countryCode\": \"BR\",\n    \"postalCode\": \"01310-100\"\n  },\n  \"socials\": {\n    \"instagram\": \"@joaosilva\",\n    \"whatsapp\": \"+5511999999999\",\n    \"x\": \"@joaosilva\",\n    \"threads\": \"@joaosilva\",\n    \"youtube\": \"https://youtube.com/@joaosilva\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/me/profile",
              "host": ["{{baseUrl}}"],
              "path": ["me", "profile"]
            }
          },
          "response": [
            {
              "name": "Success - 200",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": \"user-id\",\n  \"email\": \"user@example.com\",\n  \"firstName\": \"João\",\n  \"lastName\": \"Silva\",\n  \"gender\": \"male\",\n  \"birthDate\": \"1990-05-15T00:00:00.000Z\",\n  \"avatarUrl\": \"https://example.com/avatar.jpg\",\n  \"roles\": [\"student\"],\n  \"status\": \"active\",\n  \"address\": {\n    \"id\": \"address-id\",\n    \"line1\": \"Avenida Paulista, 1000\",\n    \"line2\": \"Apt 101\",\n    \"neighborhood\": \"Bela Vista\",\n    \"city\": \"São Paulo\",\n    \"state\": \"São Paulo\",\n    \"stateCode\": \"SP\",\n    \"country\": \"Brasil\",\n    \"countryCode\": \"BR\",\n    \"postalCode\": \"01310-100\"\n  },\n  \"socials\": {\n    \"id\": \"socials-id\",\n    \"instagram\": \"@joaosilva\",\n    \"whatsapp\": \"+5511999999999\",\n    \"x\": \"@joaosilva\",\n    \"threads\": \"@joaosilva\",\n    \"youtube\": \"https://youtube.com/@joaosilva\"\n  }\n}"
            },
            {
              "name": "Bad Request - 400",
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"error\": \"At least one field must be provided\"\n}"
            },
            {
              "name": "Not Found - 404",
              "status": "Not Found",
              "code": 404,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"code\": \"USER_NOT_FOUND\",\n  \"message\": \"User not found\",\n  \"statusCode\": 404\n}"
            }
          ],
          "description": "Updates the current user's profile. Requires authentication via JWT Bearer token. All fields are optional - only include the fields you want to update. Address and socials support nested upsert (create if not exists, update if exists)."
        },
        {
          "name": "Update My Trainer Profile (Onboarding PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trainer\": {\n    \"firstName\": \"Ana\",\n    \"lastName\": \"Silva\",\n    \"birthDate\": \"1995-08-15\",\n    \"gymName\": \"Gaujofit Gym\",\n    \"professionalDocument\": \"CREF-12345\"\n  },\n  \"address\": {\n    \"line1\": \"Av. Paulista, 1000\",\n    \"line2\": \"Apt 101\",\n    \"neighborhood\": \"Bela Vista\",\n    \"city\": \"Sao Paulo\",\n    \"state\": \"SP\",\n    \"stateCode\": \"SP\",\n    \"country\": \"Brasil\",\n    \"countryCode\": \"BR\",\n    \"postalCode\": \"01310-100\"\n  },\n  \"socials\": {\n    \"instagram\": \"@gaujofit\",\n    \"whatsapp\": \"+5511999999999\",\n    \"youtube\": \"https://youtube.com/@gaujofit\"\n  }\n}" 
            },
            "url": {
              "raw": "{{baseUrl}}/trainer",
              "host": ["{{baseUrl}}"],
              "path": ["trainer"]
            }
          },
          "description": "Requires auth via Bearer token (automatically added after login/signup). Updates trainer + one address (upsert) + socials (upsert) and sets user.status=active."
        }
      ]
    },
    {
      "name": "Users (debug/admin-ish)",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "Create User (manual)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"manual_user\",\n  \"role\": \"trainer\",\n  \"email\": \"manual@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          }
        }
      ]
    }
  ]
}

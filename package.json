{
  "name": "gaujofit_service",
  "version": "0.0.1",
  "description": "Backend for gaujofit",
  "main": "api/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node api/index.js",
    "dev": "node --watch api/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "deploy:railway": "npm run db:migrate:deploy && npm run db:generate",
    "db:studio": "npx prisma studio",
    "db:seed": "npx prisma db seed",
    "setup": "npm install && npm run db:start && sleep 3 && npm run db:migrate && npm run db:generate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "wellness",
    "training"
  ],
  "author": "",
  "license": "ISC",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --cache --fix"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "globals": "^17.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/oauth2": "^8.1.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/session": "^11.1.1",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.4",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "jose": "^6.1.3",
    "lodash": "^4.17.21",
    "pg": "^8.16.3",
    "prisma": "^7.2.0",
    "resend": "^6.8.0"
  }
}

{
  "name": "treinoway-service",
  "version": "0.0.1",
  "description": "Backend for Treinoway",
  "main": "api/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --optimize-for-size --import ./instrument.js api/index.js",
    "dev": "node --watch --import ./instrument.js api/index.js",
    "lint": "eslint . --pass-on-unpruned-suppressions",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "deploy:railway": "prisma migrate deploy && node prisma/seed.js",
    "db:studio": "npx prisma studio",
    "db:seed": "npx prisma db seed",
    "db:seed:dev": "node prisma/seeds/dev-seed.js",
    "db:reset-and-populate": "NODE_ENV=development docker compose down -v && docker compose up -d --wait && npm run db:migrate && npm run db:seed:dev",
    "setup": "npm install && npm run db:start && sleep 3 && npm run db:migrate && npm run db:generate",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'test/e2e/**'",
    "ai:eval": "node scripts/ai-eval.js",
  "openapi:export": "node scripts/export-openapi.js",
    "test:watch": "vitest",
    "test:e2e": "bash scripts/test-e2e.sh",
    "measure:memory": "node --expose-gc --optimize-for-size scripts/measure-memory.js"
  },
  "keywords": [
    "wellness",
    "training"
  ],
  "author": "",
  "license": "ISC",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --cache --fix --pass-on-unpruned-suppressions"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "eslint": "^9.39.2",
    "form-data": "^4.0.5",
    "globals": "^17.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@aws-sdk/client-s3": "^3.986.0",
    "@aws-sdk/s3-request-presigner": "^3.986.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/fast-json-stringify-compiler": "~5.0.3",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/oauth2": "^8.1.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/session": "^11.1.1",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.4",
    "@langfuse/otel": "^6.1.1",
    "@langfuse/tracing": "^6.1.1",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/core": "~2.8.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/otlp-exporter-base": "^0.219.0",
    "@opentelemetry/sdk-trace-base": "~2.8.0",
    "@opentelemetry/sdk-trace-node": "~2.8.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@sentry/node": "^10.57.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "jose": "^6.1.3",
    "lodash": "^4.17.21",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "prisma": "^7.2.0",
    "resend": "^6.8.0",
    "rollbar": "^4.2.0"
  }
}

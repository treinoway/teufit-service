{
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash($CLAUDE_PROJECT_DIR/.claude/hooks/trigger-agents.sh)"
    ],
    "deny": [
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh pr merge *)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin HEAD:master*)",
      "Bash(git push origin HEAD:staging*)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(git push origin staging*)",
      "Bash(git tag *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/trigger-agents.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-verify.sh",
            "timeout": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "g=\"$CLAUDE_PROJECT_DIR/../.claude/hooks/test-lock-guard.sh\"; [ -x \"$g\" ] && exec \"$g\"; exit 0"
          }
        ]
      }
    ]
  }
}

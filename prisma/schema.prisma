// ─── Trainer Invite (closed beta) ─────────────────────────────────────────────

model TrainerInvite {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @map("email") @db.Text // normalized lowercase, bound email
  codeHash        String    @unique @map("code_hash") @db.Text // sha256(normalizedCode)
  status          String    @default("pending") @map("status") @db.Text // pending|accepted|revoked|expired
  invitedByUserId String    @map("invited_by_user_id") @db.Uuid // generic sender (admin now, trainer later)
  userId          String?   @map("user_id") @db.Uuid // redeemer; null until redeemed (scenario A)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  invitedBy User  @relation("InvitesSent", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  redeemer  User? @relation("InvitesRedeemed", fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([invitedByUserId])
  @@index([userId])
  @@map("trainer_invites")
}

// Trainer -> prospective student invite (email-bound, no code/link). Accepted
// automatically once a user with a VERIFIED email matching `email` exists.
// A partial unique index (trainer_id, email) WHERE status = 'pending' is
// created by hand in the migration SQL (Prisma cannot express it) — do not
// drop it when regenerating migrations.
model StudentInvite {
  id         String    @id @default(uuid()) @db.Uuid
  trainerId  String    @map("trainer_id") @db.Uuid
  email      String    @db.Text // normalized lowercase
  status     String    @default("pending") @db.Text // pending|accepted|revoked|expired
  studentId  String?   @map("student_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSentAt DateTime  @default(now()) @map("last_sent_at") @db.Timestamptz(6)
  sendCount  Int       @default(1) @map("send_count")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  student User?   @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([trainerId, status, createdAt])
  @@index([email, status])
  @@index([studentId])
  @@map("student_invites")
}

// High-fidelity interaction log for closed-beta diagnostics.
// PRIVACY NOTE: userMessage and responseText may contain student personal data.
// This table is for beta-only capture and MUST have a retention policy enforced
// (e.g. purge rows older than 90 days) before any production rollout.
// Do NOT log API keys, tokens, or secrets in any field.
model AiInteractionLog {
  id             String   @id @default(uuid()) @db.Uuid
  trainerId      String   @map("trainer_id") @db.Uuid
  studentId      String?  @map("student_id") @db.Uuid
  conversationId String?  @map("conversation_id") @db.Text
  action         String   @db.Text
  userMessage    String?  @map("user_message") @db.Text
  toolsUsed      Json?    @map("tools_used")
  responseText   String?  @map("response_text") @db.Text
  model          String?  @db.Text
  inputTokens    Int?     @map("input_tokens")
  outputTokens   Int?     @map("output_tokens")
  latencyMs      Int?     @map("latency_ms")
  status         String   @db.Text
  errorCode      String?  @map("error_code") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  student User?   @relation("aiInteractionLogStudent", fields: [studentId], references: [id], onDelete: SetNull)

  @@index([trainerId, createdAt])
  @@map("ai_interaction_logs")
}


// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  username     String? @db.Text
  email        String? @unique @db.Text
  passwordHash String? @map("password_hash") @db.Text
  status       String  @default("pending") @db.Text

  // Personal data (single source of truth)
  firstName String?   @map("first_name") @db.Text
  gender    String?   @db.Text
  lastName  String?   @map("last_name") @db.Text
  birthDate DateTime? @map("birth_date") @db.Date
  avatarUrl String?   @map("avatar_url") @db.Text

  // Logical roles, kept for authorization
  roles String[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  accounts            Account[]
  healthDetail        UserHealthDetail?
  trainer             Trainer?
  address             Address?
  socials             SocialNetwork?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  nutritionist        Nutritionist?
  preferences         UserPreferences?
  protocolsAsAssignee TrainingProtocol[]
  trainers            TrainerStudent[]
  workoutSessions     WorkoutSession[]
  studentAnamneses    StudentAnamnesis[]

  @@map("users")
}

model UserPreferences {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @unique @map("user_id") @db.Uuid
  activeProfile  String @default("student") @map("active_profile") @db.Text
  rawPreferences Json?  @map("raw_preferences")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_preferences")
}

model UserHealthDetail {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  weight     Float?
  height     Float?
  bodyFat    Float?  @map("body_fat")
  conditions String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_health_details")
}

model Trainer {
  id                   String  @id @default(uuid()) @db.Uuid
  userId               String  @map("user_id") @db.Uuid
  professionalDocument String? @map("professional_document") @db.Text
  gymName              String? @map("gym_name") @db.Text
  notes                String? @db.Text

  // Service mode: online | in_person | hybrid
  serviceMode String? @map("service_mode") @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  trainingProtocols         TrainingProtocol[]
  trainingProtocolTemplates TrainingProtocolTemplate[]
  trainingTemplates         TrainingTemplate[]
  exerciseTemplates         ExerciseTemplate[]
  students                  TrainerStudent[]
  anamneses                 Anamnesis[]
  studentAnamneses          StudentAnamnesis[]

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId])
  @@map("trainers")
}

model Address {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @unique @map("user_id") @db.Uuid
  line1        String? @db.Text
  line2        String? @db.Text
  neighborhood String? @db.Text
  city         String? @db.Text
  state        String? @db.Text
  stateCode    String? @map("state_code") @db.Text
  country      String? @db.Text
  countryCode  String? @map("country_code") @db.Text
  postalCode   String? @map("postal_code") @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("addresses")
}

model SocialNetwork {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @unique @map("user_id") @db.Uuid
  instagram String? @db.Text
  whatsapp  String? @db.Text
  x         String? @db.Text
  threads   String? @db.Text
  youtube   String? @db.Text
  linkedin  String? @db.Text
  facebook  String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("socials_networks")
}

model Account {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  provider     String    @db.Text
  providerId   String    @map("provider_id") @db.Text
  accessToken  String?   @map("access_token") @db.Text
  refreshToken String?   @map("refresh_token") @db.Text
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("accounts")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Text
  userId    String    @map("user_id") @db.Uuid
  revoked   Boolean   @default(false)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Text
  userId    String   @map("user_id") @db.Uuid
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Nutritionist {
  id            String  @id @default(uuid()) @db.Uuid
  userId        String  @map("user_id") @db.Uuid
  councilNumber String? @map("council_number") @db.Text
  specialties   String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId])
  @@map("nutritionists")
}

model UserWaitlist {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.Text
  status    String   @default("pending") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_waitlist")
}

model TrainingProtocolTemplate {
  id                   String   @id @default(uuid()) @db.Uuid
  trainerId            String   @map("trainer_id") @db.Uuid
  name                 String   @db.Text
  description          String?  @db.Text
  defaultDurationWeeks Int?     @map("default_duration_weeks")
  genderOrdination     String?  @map("gender_ordination") @db.Text
  trainingLevel        String?  @map("training_level") @db.Text
  type                 String?  @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  trainer           Trainer                    @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  protocols         TrainingProtocol[]
  trainings         ProtocolTemplateTraining[]

  @@map("training_protocol_templates")
}

model TrainingProtocol {
  id                 String    @id @default(uuid()) @db.Uuid
  assigneeId         String    @map("assignee_id") @db.Uuid
  trainerId          String    @map("trainer_id") @db.Uuid
  protocolTemplateId String?   @map("protocol_template_id") @db.Uuid
  name               String    @db.Text
  description        String?   @db.Text
  status             String    @default("active") @db.Text
  startDate          DateTime  @map("start_date") @db.Date
  expirationDate     DateTime? @map("expiration_date") @db.Date
  genderOrdination   String?   @map("gender_ordination") @db.Text
  trainingLevel      String?   @map("training_level") @db.Text
  type               String?   @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  assignee         User                      @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  trainer          Trainer                   @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  protocolTemplate TrainingProtocolTemplate? @relation(fields: [protocolTemplateId], references: [id], onDelete: SetNull)
  trainings        Training[]

  @@map("training_protocols")
}

model TrainingTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  trainerId   String   @map("trainer_id") @db.Uuid
  name        String   @db.Text
  description String?  @db.Text
  category    String   @db.Text
  bodySegment String?  @map("body_segment") @db.Text
  tags        String[] @default([])
  isPublic    Boolean  @default(false) @map("is_public")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  trainer                           Trainer                              @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  trainings                         Training[]
  protocolTemplateTrainings        ProtocolTemplateTraining[]
  trainingTemplateExerciseTemplates TrainingTemplateExerciseTemplate[]

  @@map("training_templates")
}

model Training {
  id                 String  @id @default(uuid()) @db.Uuid
  trainingProtocolId String  @map("training_protocol_id") @db.Uuid
  trainingTemplateId String? @map("training_template_id") @db.Uuid
  name               String  @db.Text
  description        String? @db.Text
  category           String  @db.Text
  bodySegment        String? @map("body_segment") @db.Text
  weekDay            String? @map("week_day") @db.Text
  order              Int     @default(0)
  notes              String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  trainingProtocol TrainingProtocol  @relation(fields: [trainingProtocolId], references: [id], onDelete: Cascade)
  trainingTemplate TrainingTemplate? @relation(fields: [trainingTemplateId], references: [id], onDelete: SetNull)
  exercises        Exercise[]
  workoutSessions  WorkoutSession[]

  @@map("trainings")
}

model ExerciseTemplate {
  id        String  @id @default(uuid()) @db.Uuid
  trainerId String  @map("trainer_id") @db.Uuid
  name      String  @db.Text
  type      String  @db.Text
  videoUrl  String? @map("video_url") @db.Text
  isPublic  Boolean @default(false) @map("is_public")

  sets          Int?
  repetitions   Json?
  duration      Int?
  hasLoad       Boolean @default(false) @map("has_load")
  suggestedLoad Float?  @map("suggested_load")
  notes         String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  trainer   Trainer   @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  exercises Exercise[]
  trainingTemplateExerciseTemplates TrainingTemplateExerciseTemplate[]

  @@map("exercise_templates")
}

model TrainingTemplateExerciseTemplate {
  id                 String  @id @default(uuid()) @db.Uuid
  trainingTemplateId String  @map("training_template_id") @db.Uuid
  exerciseTemplateId String  @map("exercise_template_id") @db.Uuid
  order              Int     @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  trainingTemplate TrainingTemplate @relation(fields: [trainingTemplateId], references: [id], onDelete: Cascade)
  exerciseTemplate ExerciseTemplate @relation(fields: [exerciseTemplateId], references: [id], onDelete: Cascade)

  @@unique([trainingTemplateId, exerciseTemplateId])
  @@map("training_template_exercise_templates")
}

model Exercise {
  id                 String  @id @default(uuid()) @db.Uuid
  trainingId         String  @map("training_id") @db.Uuid
  exerciseTemplateId String? @map("exercise_template_id") @db.Uuid
  name               String  @db.Text
  type               String  @db.Text
  videoUrl           String? @map("video_url") @db.Text
  order              Int     @default(0)

  sets          Int?
  repetitions   Json?
  duration      Int?
  hasLoad       Boolean @default(false) @map("has_load")
  suggestedLoad Float?  @map("suggested_load")
  notes         String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  training         Training          @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  exerciseTemplate ExerciseTemplate? @relation(fields: [exerciseTemplateId], references: [id], onDelete: SetNull)
  exerciseLogs     ExerciseLog[]

  @@map("exercises")
}

model ProtocolTemplateTraining {
  id                 String  @id @default(uuid()) @db.Uuid
  protocolTemplateId String  @map("protocol_template_id") @db.Uuid
  trainingTemplateId String  @map("training_template_id") @db.Uuid
  weekDay            String? @map("week_day") @db.Text
  order              Int     @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  protocolTemplate TrainingProtocolTemplate @relation(fields: [protocolTemplateId], references: [id], onDelete: Cascade)
  trainingTemplate TrainingTemplate         @relation(fields: [trainingTemplateId], references: [id], onDelete: Cascade)

  @@map("protocol_template_trainings")
}

model TrainerStudent {
  id        String @id @default(uuid()) @db.Uuid
  trainerId String @map("trainer_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([trainerId, studentId])
  @@map("trainer_students")
}

model WorkoutSession {
  id              String    @id @default(uuid()) @db.Uuid
  trainingId      String    @map("training_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  status          String    @default("in_progress") @db.Text
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(6)
  durationSeconds Int?      @map("duration_seconds")
  notes           String?   @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  training     Training      @relation(fields: [trainingId], references: [id], onDelete: Restrict)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  exerciseLogs ExerciseLog[]

  @@map("workout_sessions")
}

model ExerciseLog {
  id               String  @id @default(uuid()) @db.Uuid
  workoutSessionId String  @map("workout_session_id") @db.Uuid
  exerciseId       String  @map("exercise_id") @db.Uuid
  status           String  @default("pending") @db.Text
  order            Int     @default(0)
  notes            String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise       Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  setLogs        SetLog[]

  @@map("exercise_logs")
}

model SetLog {
  id            String  @id @default(uuid()) @db.Uuid
  exerciseLogId String  @map("exercise_log_id") @db.Uuid
  setNumber     Int     @map("set_number")
  repetitions   Int?
  load          Float?
  duration      Int?
  rpe           Int?
  restSeconds   Int?    @map("rest_seconds")
  completed     Boolean @default(true)
  notes         String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  exerciseLog ExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)

  @@map("set_logs")
}

// ─── Anamnesis models ─────────────────────────────────────────────────────────

model Anamnesis {
  id          String  @id @default(uuid()) @db.Uuid
  trainerId   String? @map("trainer_id") @db.Uuid
  title       String  @db.Text
  description String? @db.Text
  isGeneral   Boolean @default(false) @map("is_general")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  trainer          Trainer?           @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  sections         AnamnesisSection[]
  studentAnamneses StudentAnamnesis[]

  @@map("anamneses")
}

model AnamnesisSection {
  id          String  @id @default(uuid()) @db.Uuid
  anamnesisId String  @map("anamnesis_id") @db.Uuid
  title       String  @db.Text
  description String? @db.Text
  order       Int     @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  anamnesis Anamnesis           @relation(fields: [anamnesisId], references: [id], onDelete: Cascade)
  questions AnamnesisQuestion[]

  @@map("anamnesis_sections")
}

model AnamnesisQuestion {
  id        String  @id @default(uuid()) @db.Uuid
  sectionId String  @map("section_id") @db.Uuid
  text      String  @db.Text
  type      String  @db.Text
  required  Boolean @default(false)
  order     Int     @default(0)
  config    Json?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  section AnamnesisSection         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  options AnamnesisQuestionOption[]

  @@map("anamnesis_questions")
}

model AnamnesisQuestionOption {
  id         String @id @default(uuid()) @db.Uuid
  questionId String @map("question_id") @db.Uuid
  text       String @db.Text
  order      Int    @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  question AnamnesisQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("anamnesis_question_options")
}

model StudentAnamnesis {
  id          String @id @default(uuid()) @db.Uuid
  anamnesisId String @map("anamnesis_id") @db.Uuid
  studentId   String @map("student_id") @db.Uuid
  trainerId   String @map("trainer_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  anamnesis Anamnesis @relation(fields: [anamnesisId], references: [id], onDelete: Restrict)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  trainer   Trainer   @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([anamnesisId, studentId, trainerId])
  @@map("student_anamneses")
}

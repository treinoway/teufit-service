  protocolTemplateId String  @map("protocol_template_id") @db.Uuid
  trainingTemplateId String  @map("training_template_id") @db.Uuid
  weekDay            String? @map("week_day") @db.Text
  order              Int     @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  protocolTemplate TrainingProtocolTemplate @relation(fields: [protocolTemplateId], references: [id], onDelete: Cascade)
  trainingTemplate TrainingTemplate         @relation(fields: [trainingTemplateId], references: [id], onDelete: Cascade)

  @@map("protocol_template_trainings")
}

model TrainerStudent {
  id           String  @id @default(uuid()) @db.Uuid
  trainerId    String  @map("trainer_id") @db.Uuid
  studentId    String  @map("student_id") @db.Uuid
  activeOnPlan Boolean @default(true) @map("active_on_plan")

  // Denormalized hot-path fields for the trainer's students list.
  // Populated by write-time hooks (see workout-session-service):
  //   lastWorkoutAt — updated when a WorkoutSession is completed
  //   currentPrLoad/currentPrAt — updated when a SetLog records a load
  //     strictly greater than the current value
  // This avoids fan-out aggregation queries on the students list endpoint.
  lastWorkoutAt DateTime? @map("last_workout_at") @db.Timestamptz(6)
  currentPrLoad Float?    @map("current_pr_load")
  currentPrAt   DateTime? @map("current_pr_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([trainerId, studentId])
  @@index([studentId])
  @@index([trainerId, activeOnPlan])
  @@map("trainer_students")
}

model WorkoutSession {
  id              String    @id @default(uuid()) @db.Uuid
  trainingId      String    @map("training_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  status          String    @default("in_progress") @db.Text
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(6)
  durationSeconds Int?      @map("duration_seconds")
  notes           String?   @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  training     Training      @relation(fields: [trainingId], references: [id], onDelete: Restrict)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  exerciseLogs ExerciseLog[]

  @@index([userId, status, startedAt(sort: Desc)])
  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, status, finishedAt])
  @@map("workout_sessions")
}

model ExerciseLog {
  id               String  @id @default(uuid()) @db.Uuid
  workoutSessionId String  @map("workout_session_id") @db.Uuid
  exerciseId       String  @map("exercise_id") @db.Uuid
  status           String  @default("pending") @db.Text
  order            Int     @default(0)
  notes            String? @db.Text

  // Substitute swap fields
  substitutedByExerciseId String? @map("substituted_by_exercise_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise       Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  setLogs        SetLog[]

  @@index([workoutSessionId, exerciseId])
  @@index([exerciseId])
  @@map("exercise_logs")
}

model SetLog {
  id            String  @id @default(uuid()) @db.Uuid
  exerciseLogId String  @map("exercise_log_id") @db.Uuid
  setNumber     Int     @map("set_number")
  repetitions   Int?
  load          Float?
  duration      Int?
  rpe           Int?
  restSeconds   Int?    @map("rest_seconds")
  completed     Boolean @default(true)

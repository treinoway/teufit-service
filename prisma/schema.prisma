model ExerciseTemplateAdvancedTechnique {
  id                  String @id @default(uuid()) @db.Uuid
  exerciseTemplateId  String @map("exercise_template_id") @db.Uuid
  advancedTechniqueId String @map("advanced_technique_id") @db.Uuid
  order               Int    @default(0)

  exerciseTemplate  ExerciseTemplate  @relation(fields: [exerciseTemplateId], references: [id], onDelete: Cascade)
  advancedTechnique AdvancedTechnique @relation(fields: [advancedTechniqueId], references: [id], onDelete: Cascade)

  @@unique([exerciseTemplateId, advancedTechniqueId])
  @@index([advancedTechniqueId])
  @@map("exercise_template_advanced_techniques")
}

model TrainingTemplateExerciseAdvancedTechnique {
  id                                 String @id @default(uuid()) @db.Uuid
  trainingTemplateExerciseTemplateId String @map("training_template_exercise_template_id") @db.Uuid
  advancedTechniqueId                String @map("advanced_technique_id") @db.Uuid
  order                              Int    @default(0)

  trainingTemplateExerciseTemplate TrainingTemplateExerciseTemplate @relation(fields: [trainingTemplateExerciseTemplateId], references: [id], onDelete: Cascade)
  advancedTechnique                AdvancedTechnique                @relation(fields: [advancedTechniqueId], references: [id], onDelete: Cascade)

  @@unique([trainingTemplateExerciseTemplateId, advancedTechniqueId])
  @@index([advancedTechniqueId])
  @@map("training_template_exercise_advanced_techniques")
}

// Consistency ranking: references Trainer and User (never TrainerStudent) so history survives unlinking.
model ConsistencyRankingConfig {
  id             String    @id @default(uuid()) @db.Uuid
  trainerId      String    @unique @map("trainer_id") @db.Uuid
  minPodiumWeeks Int       @default(2) @map("min_podium_weeks")
  seasonWeeks    Int       @default(4) @map("season_weeks")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@map("consistency_ranking_configs")
}

model ConsistencyScoringRule {
  id            String   @id @default(uuid()) @db.Uuid
  trainerId     String   @map("trainer_id") @db.Uuid
  effectiveFrom DateTime @map("effective_from") @db.Date
  weights       Json
  activePillars String[] @map("active_pillars")
  closeWeekday  Int      @map("close_weekday")
  closeHour     Int      @map("close_hour")
  timeZone      String   @map("time_zone") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([trainerId, effectiveFrom])
  @@map("consistency_scoring_rules")
}

model ConsistencySeason {
  id               String    @id @default(uuid()) @db.Uuid
  trainerId        String    @map("trainer_id") @db.Uuid
  number           Int
  startWeek        DateTime  @map("start_week") @db.Date
  weeks            Int
  status           String    @default("active") @db.Text
  closeRequestedAt DateTime? @map("close_requested_at") @db.Timestamptz(6)
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(6)

  trainer   Trainer                     @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  results   ConsistencyWeeklyResult[]
  standings ConsistencySeasonStanding[]

  @@unique([trainerId, number])
  @@index([trainerId, status])
  @@map("consistency_seasons")
}

model ConsistencyWeeklyTarget {
  id        String   @id @default(uuid()) @db.Uuid
  trainerId String   @map("trainer_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  weekStart DateTime @map("week_start") @db.Date
  pillar    String   @db.Text
  expected  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([trainerId, studentId, weekStart, pillar])
  @@index([trainerId, weekStart])
  @@map("consistency_weekly_targets")
}

model ConsistencyWeeklyResult {
  id        String   @id @default(uuid()) @db.Uuid
  trainerId String   @map("trainer_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  seasonId  String   @map("season_id") @db.Uuid
  weekStart DateTime @map("week_start") @db.Date
  status    String   @db.Text
  score     Decimal? @db.Decimal(7, 4)
  pillars   Json
  weights   Json
  closedAt  DateTime @map("closed_at") @db.Timestamptz(6)

  trainer Trainer           @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  student User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  season  ConsistencySeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([trainerId, studentId, weekStart])
  @@index([trainerId, seasonId])
  @@index([trainerId, studentId, weekStart(sort: Desc)])
  @@map("consistency_weekly_results")
}

model ConsistencyWeekClose {
  id            String   @id @default(uuid()) @db.Uuid
  trainerId     String   @map("trainer_id") @db.Uuid
  weekStart     DateTime @map("week_start") @db.Date
  closedAt      DateTime @map("closed_at") @db.Timestamptz(6)
  studentsCount Int      @map("students_count")

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([trainerId, weekStart])
  @@map("consistency_week_closes")
}

model ConsistencySeasonStanding {
  id         String   @id @default(uuid()) @db.Uuid
  seasonId   String   @map("season_id") @db.Uuid
  trainerId  String   @map("trainer_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  position   Int?
  eligible   Boolean
  average    Decimal? @db.Decimal(7, 4)
  validWeeks Int      @map("valid_weeks")
  weeks100   Int      @map("weeks_100")
  streak     Int
  frozenAt   DateTime @map("frozen_at") @db.Timestamptz(6)

  season  ConsistencySeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  trainer Trainer           @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  student User              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([seasonId, studentId])
  @@map("consistency_season_standings")
}

// Uniqueness is enforced by two partial unique indexes appended by hand in the migration (Prisma cannot model them).
model ConsistencyWeekPause {
  id        String   @id @default(uuid()) @db.Uuid
  trainerId String   @map("trainer_id") @db.Uuid
  studentId String?  @map("student_id") @db.Uuid
  weekStart DateTime @map("week_start") @db.Date
  paused    Boolean  @default(true)
  reason    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  student User?   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([trainerId, weekStart])
  @@map("consistency_week_pauses")
}

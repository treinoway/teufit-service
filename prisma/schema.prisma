// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  username     String? @db.Text
  email        String? @unique @db.Text
  passwordHash String? @map("password_hash") @db.Text
  status       String  @default("pending") @db.Text

  // Personal data (single source of truth)
  firstName String?   @map("first_name") @db.Text
  gender    String?   @db.Text
  lastName  String?   @map("last_name") @db.Text
  birthDate DateTime? @map("birth_date") @db.Date
  avatarUrl String?   @map("avatar_url") @db.Text

  // Logical roles, kept for authorization
  roles String[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  accounts                   Account[]
  healthDetail               UserHealthDetail?
  trainer                    Trainer?
  address                    Address?
  socials                    SocialNetwork?
  refreshTokens              RefreshToken[]
  passwordResetTokens        PasswordResetToken[]
  nutritionist               Nutritionist?
  preferences                UserPreferences?
  protocolsAsAssignee        TrainingProtocol[]
  trainers                   TrainerStudent[]
  workoutSessions            WorkoutSession[]
  studentAnamneses           StudentAnamnesis[]
  anamnesisResponses         AnamnesisResponse[]         @relation("AnamnesisResponseStudent")
  anamnesisResponsesFilled   AnamnesisResponse[]         @relation("AnamnesisResponseFiller")
  aiConversations            AiConversation[]
  challengeParticipants      ChallengeParticipant[]
  pointTransactions          PointTransaction[]
  pointBalances              PointBalance[]
  nutritionistPatients       NutritionistPatient[]
  metabolicProfile           PatientMetabolicProfile?
  dietProtocolsAsPatient     DietProtocol[]
  videosCreated              Video[]
  tutorialsCreated           Tutorial[]
  studentSubscriptions       StudentSubscription[]
  aiUsageEventsAsStudent     AiUsageEvent[]              @relation("aiUsageStudent")
  aiTokenUsagesAsStudent     AiTokenUsage[]              @relation("aiTokenUsageStudent")
  aiInteractionLogsAsStudent AiInteractionLog[]          @relation("aiInteractionLogStudent")
  invitesSent                TrainerInvite[]             @relation("InvitesSent")
  invitesRedeemed            TrainerInvite[]             @relation("InvitesRedeemed")
  emailVerificationTokens    EmailVerificationToken[]
  studentInvitesAccepted     StudentInvite[]
  consistencyWeeklyTargets   ConsistencyWeeklyTarget[]
  consistencyWeeklyResults   ConsistencyWeeklyResult[]
  consistencySeasonStandings ConsistencySeasonStanding[]
  consistencyWeekPauses      ConsistencyWeekPause[]

  // Added for the manager backoffice user list (ORDER BY created_at DESC).
  @@index([createdAt])
  @@map("users")
}

model UserPreferences {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @unique @map("user_id") @db.Uuid
  activeProfile  String @default("student") @map("active_profile") @db.Text
  rawPreferences Json?  @map("raw_preferences")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_preferences")
}

model UserHealthDetail {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  weight     Float?
  height     Float?
  bodyFat    Float?  @map("body_fat")
  conditions String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_health_details")
}

model Trainer {
  id                   String  @id @default(uuid()) @db.Uuid
  userId               String  @map("user_id") @db.Uuid
  professionalDocument String? @map("professional_document") @db.Text
  gymName              String? @map("gym_name") @db.Text
  notes                String? @db.Text

  // Service mode: online | in_person | hybrid
  serviceMode String? @map("service_mode") @db.Text

  profileCompletedAt     DateTime? @map("profile_completed_at") @db.Timestamptz(6)
  firstStudentLinkedAt   DateTime? @map("first_student_linked_at") @db.Timestamptz(6)
  firstProtocolCreatedAt DateTime? @map("first_protocol_created_at") @db.Timestamptz(6)
  firstStudentInvitedAt  DateTime? @map("first_student_invited_at") @db.Timestamptz(6)
  firstAnamnesisSentAt   DateTime? @map("first_anamnesis_sent_at") @db.Timestamptz(6)
  brandingConfiguredAt   DateTime? @map("branding_configured_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  trainingProtocols          TrainingProtocol[]
  trainingProtocolTemplates  TrainingProtocolTemplate[]
  trainingTemplates          TrainingTemplate[]
  exerciseTemplates          ExerciseTemplate[]
  advancedTechniques         AdvancedTechnique[]
  students                   TrainerStudent[]
  studentInvites             StudentInvite[]
  anamneses                  Anamnesis[]
  studentAnamneses           StudentAnamnesis[]
  branding                   TrainerBranding?
  gamificationConfig         GamificationConfig?
  pointTransactions          PointTransaction[]
  pointBalances              PointBalance[]
  challenges                 Challenge[]
  subscriptionPlans          SubscriptionPlan[]
  studentSubscriptions       StudentSubscription[]
  briefingSnapshot           TrainerBriefingSnapshot?
  platformSubscription       PlatformSubscription?
  aiUsageEvents              AiUsageEvent[]
  aiTokenUsages              AiTokenUsage[]
  aiInteractionLogs          AiInteractionLog[]
  feedbacks                  TrainerFeedback[]
  consistencyRankingConfig   ConsistencyRankingConfig?
  consistencyScoringRules    ConsistencyScoringRule[]
  consistencySeasons         ConsistencySeason[]
  consistencyWeeklyTargets   ConsistencyWeeklyTarget[]
  consistencyWeeklyResults   ConsistencyWeeklyResult[]
  consistencyWeekCloses      ConsistencyWeekClose[]
  consistencySeasonStandings ConsistencySeasonStanding[]
  consistencyWeekPauses      ConsistencyWeekPause[]

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId])
  @@map("trainers")
}

model TrainerBranding {
  id             String  @id @default(uuid()) @db.Uuid
  trainerId      String  @unique @map("trainer_id") @db.Uuid
  primaryColor   String  @map("primary_color") @db.Text
  secondaryColor String? @map("secondary_color") @db.Text
  logoUrl        String? @map("logo_url") @db.Text
  coverImageUrl  String? @map("cover_image_url") @db.Text
  welcomeMessage String? @map("welcome_message") @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@map("trainer_brandings")
}

model Address {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @unique @map("user_id") @db.Uuid
  line1        String? @db.Text
  line2        String? @db.Text
  neighborhood String? @db.Text
  city         String? @db.Text
  state        String? @db.Text
  stateCode    String? @map("state_code") @db.Text
  country      String? @db.Text
  countryCode  String? @map("country_code") @db.Text
  postalCode   String? @map("postal_code") @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("addresses")
}

model SocialNetwork {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @unique @map("user_id") @db.Uuid
  instagram String? @db.Text
  whatsapp  String? @db.Text
  x         String? @db.Text
  threads   String? @db.Text
  youtube   String? @db.Text
  linkedin  String? @db.Text
  facebook  String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("socials_networks")
}

model Account {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  provider     String    @db.Text
  providerId   String    @map("provider_id") @db.Text
  accessToken  String?   @map("access_token") @db.Text
  refreshToken String?   @map("refresh_token") @db.Text
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  // Set when the provider identity is proven to own the email: OAuth accounts
  // at creation (ID token email_verified), email accounts via the verify-email
  // flow. A user's email counts as verified when ANY account has this set.
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("accounts")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Text
  userId    String    @map("user_id") @db.Uuid
  revoked   Boolean   @default(false)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  // Not unique: a 6-digit code can legitimately collide with an old used row.
  // Lookups are always scoped by userId.
  tokenHash String   @map("token_hash") @db.Text
  userId    String   @map("user_id") @db.Uuid
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @map("token_hash") @db.Text // sha256(6-digit code)
  userId       String    @map("user_id") @db.Uuid
  used         Boolean   @default(false)
  attempts     Int       @default(0)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  // Set when the email carrying this code could not be delivered. The row is
  // also closed (used = true); it is ignored by the resend cooldown and daily cap.
  sendFailedAt DateTime? @map("send_failed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, used])
  @@map("email_verification_tokens")
}

// Email/password signup awaiting inbox proof. No User row exists until the
// code is confirmed (POST /auth/signup/verify), so an unverified signup can
// neither squat an email nor touch an existing account. The password is NOT
// stored here: it is sent again with the code, so whoever proves the inbox
// also chooses the password (a stored hash could be overwritten by anyone
// re-submitting the signup form for that email).
model PendingSignup {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.Text // trimmed + lowercased
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // Touched on every signup / resend; rows idle for 24h are purged opportunistically.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  codes PendingSignupCode[]

  @@index([updatedAt])
  @@map("pending_signups")
}

// Same lifecycle as EmailVerificationToken (see email-verification-service),
// owned by a PendingSignup instead of a User.
model PendingSignupCode {
  id              String    @id @default(uuid()) @db.Uuid
  pendingSignupId String    @map("pending_signup_id") @db.Uuid
  tokenHash       String    @map("token_hash") @db.Text // sha256(6-digit code)
  used            Boolean   @default(false)
  attempts        Int       @default(0)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sendFailedAt    DateTime? @map("send_failed_at") @db.Timestamptz(6)

  pendingSignup PendingSignup @relation(fields: [pendingSignupId], references: [id], onDelete: Cascade)

  @@index([pendingSignupId, used])
  @@map("pending_signup_codes")
}

// Throttle for the "you already have an account" email sent when someone
// signs up (or asks for a signup code) with an email that already has a User.
model ExistingAccountNotice {
  email      String   @id @db.Text // trimmed + lowercased
  lastSentAt DateTime @map("last_sent_at") @db.Timestamptz(6)

  @@map("existing_account_notices")
}

model Nutritionist {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @unique @map("user_id") @db.Uuid
  professionalDocument String?   @map("professional_document") @db.Text
  clinicName           String?   @map("clinic_name") @db.Text
  notes                String?   @db.Text
  serviceMode          String?   @map("service_mode") @db.Text
  profileCompletedAt   DateTime? @map("profile_completed_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  patients              NutritionistPatient[]
  metabolicProfiles     PatientMetabolicProfile[]
  dietProtocolTemplates DietProtocolTemplate[]
  dietProtocols         DietProtocol[]

  @@map("nutritionists")
}

model UserWaitlist {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.Text
  status    String   @default("pending") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_waitlist")
}

model TrainingProtocolTemplate {
  id                   String  @id @default(uuid()) @db.Uuid
  trainerId            String  @map("trainer_id") @db.Uuid
  name                 String  @db.Text
  description          String? @db.Text
  defaultDurationWeeks Int?    @map("default_duration_weeks")
  genderOrdination     String? @map("gender_ordination") @db.Text
  trainingLevel        String? @map("training_level") @db.Text
  type                 String? @db.Text
  isExample            Boolean @default(false) @map("is_example")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  trainer   Trainer                    @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  protocols TrainingProtocol[]
  trainings ProtocolTemplateTraining[]

  @@index([trainerId, deletedAt])
  @@map("training_protocol_templates")
}

model TrainingProtocol {
  id                 String    @id @default(uuid()) @db.Uuid
  assigneeId         String    @map("assignee_id") @db.Uuid
  trainerId          String    @map("trainer_id") @db.Uuid
  protocolTemplateId String?   @map("protocol_template_id") @db.Uuid
  name               String    @db.Text
  description        String?   @db.Text
  status             String    @default("active") @db.Text
  startDate          DateTime  @map("start_date") @db.Date
  expirationDate     DateTime? @map("expiration_date") @db.Date
  genderOrdination   String?   @map("gender_ordination") @db.Text
  trainingLevel      String?   @map("training_level") @db.Text
  type               String?   @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  assignee         User                      @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  trainer          Trainer                   @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  protocolTemplate TrainingProtocolTemplate? @relation(fields: [protocolTemplateId], references: [id], onDelete: SetNull)
  trainings        Training[]

  @@index([assigneeId, status, startDate(sort: Desc)])
  @@index([trainerId])
  // Added for GET /trainer/dashboard: routines.expiredCount/expiringSoonCount
  // filter by trainerId + status + expirationDate together — this composite
  // turns those COUNT(*) queries into index scans instead of a trainerId
  // index lookup followed by a heap filter on status/expirationDate.
  @@index([trainerId, status, expirationDate])
  @@map("training_protocols")
}

model TrainingTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  trainerId   String   @map("trainer_id") @db.Uuid
  name        String   @db.Text
  description String?  @db.Text
  category    String   @db.Text
  bodySegment String?  @map("body_segment") @db.Text
  tags        String[] @default([])
  isPublic    Boolean  @default(false) @map("is_public")
  isExample   Boolean  @default(false) @map("is_example")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  trainer                           Trainer                            @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  trainings                         Training[]
  protocolTemplateTrainings         ProtocolTemplateTraining[]
  trainingTemplateExerciseTemplates TrainingTemplateExerciseTemplate[]

  @@index([trainerId, deletedAt])
  @@index([isPublic, deletedAt])
  @@map("training_templates")
}

model Training {
  id                       String  @id @default(uuid()) @db.Uuid
  trainingProtocolId       String  @map("training_protocol_id") @db.Uuid
  trainingTemplateId       String? @map("training_template_id") @db.Uuid
  name                     String  @db.Text
  description              String? @db.Text
  category                 String  @db.Text
  bodySegment              String? @map("body_segment") @db.Text
  weekDay                  String? @map("week_day") @db.Text
  order                    Int     @default(0)
  notes                    String? @db.Text
  estimatedDurationSeconds Int     @default(0) @map("estimated_duration_seconds")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  trainingProtocol TrainingProtocol  @relation(fields: [trainingProtocolId], references: [id], onDelete: Cascade)
  trainingTemplate TrainingTemplate? @relation(fields: [trainingTemplateId], references: [id], onDelete: SetNull)
  exercises        Exercise[]
  workoutSessions  WorkoutSession[]

  // Added for protocol detail and trainingsCount joins (FK had no index).
  @@index([trainingProtocolId])
  @@map("trainings")
}

model ExerciseTemplate {
  id           String  @id @default(uuid()) @db.Uuid
  trainerId    String  @map("trainer_id") @db.Uuid
  name         String  @db.Text
  type         String  @db.Text
  videoUrl     String? @map("video_url") @db.Text
  gifUrl       String? @map("gif_url") @db.Text
  videoFileKey String? @map("video_file_key") @db.Text
  isPublic     Boolean @default(false) @map("is_public")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  trainer                           Trainer                             @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  exercises                         Exercise[]
  trainingTemplateExerciseTemplates TrainingTemplateExerciseTemplate[]
  advancedTechniqueLinks            ExerciseTemplateAdvancedTechnique[]

  @@index([trainerId, type])
  @@index([trainerId, deletedAt])
  @@index([isPublic, deletedAt])
  @@map("exercise_templates")
}

model TrainingTemplateExerciseTemplate {
  id                 String @id @default(uuid()) @db.Uuid
  trainingTemplateId String @map("training_template_id") @db.Uuid
  exerciseTemplateId String @map("exercise_template_id") @db.Uuid
  order              Int    @default(0)

  // Superset group fields — carried through template import
  supersetGroupId      String? @map("superset_group_id") @db.Uuid
  supersetOrder        Int     @default(0) @map("superset_order")
  supersetRestInterval Int?    @map("superset_rest_interval")

  // Snapshot fields — copied from ExerciseTemplate at link time; independent after that
  name             String  @db.Text
  type             String  @db.Text
  videoUrl         String? @map("video_url") @db.Text
  gifUrl           String? @map("gif_url") @db.Text
  videoFileKey     String? @map("video_file_key") @db.Text
  sets             Int?
  repetitions      Json?
  duration         Int?
  prescriptionMode String? @map("prescription_mode") @db.Text
  hasLoad          Boolean @default(false) @map("has_load")
  suggestedLoad    Float?  @map("suggested_load")
  restInterval     Int?    @map("rest_interval")
  notes            String? @db.Text
  intensity        String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  trainingTemplate       TrainingTemplate                            @relation(fields: [trainingTemplateId], references: [id], onDelete: Cascade)
  exerciseTemplate       ExerciseTemplate                            @relation(fields: [exerciseTemplateId], references: [id], onDelete: Cascade)
  advancedTechniqueLinks TrainingTemplateExerciseAdvancedTechnique[]

  @@index([trainingTemplateId])
  @@index([exerciseTemplateId])
  @@map("training_template_exercise_templates")
}

model Exercise {
  id                 String  @id @default(uuid()) @db.Uuid
  trainingId         String  @map("training_id") @db.Uuid
  exerciseTemplateId String? @map("exercise_template_id") @db.Uuid
  name               String  @db.Text
  type               String  @db.Text
  videoUrl           String? @map("video_url") @db.Text
  gifUrl             String? @map("gif_url") @db.Text
  videoFileKey       String? @map("video_file_key") @db.Text
  order              Int     @default(0)

  // Superset (bi-set / tri-set) group fields
  supersetGroupId      String? @map("superset_group_id") @db.Uuid
  supersetOrder        Int     @default(0) @map("superset_order")
  supersetRestInterval Int?    @map("superset_rest_interval")

  // Substitute exercise fields
  substituteForExerciseId String? @map("substitute_for_exercise_id") @db.Uuid
  substituteOrder         Int     @default(0) @map("substitute_order")

  sets             Int?
  repetitions      Json?
  duration         Int?
  prescriptionMode String? @map("prescription_mode") @db.Text
  hasLoad          Boolean @default(false) @map("has_load")
  suggestedLoad    Float?  @map("suggested_load")
  restInterval     Int?    @map("rest_interval")
  notes            String? @db.Text
  intensity        String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  training               Training                    @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  exerciseTemplate       ExerciseTemplate?           @relation(fields: [exerciseTemplateId], references: [id], onDelete: SetNull)
  exerciseLogs           ExerciseLog[]
  substituteFor          Exercise?                   @relation("ExerciseSubstitutes", fields: [substituteForExerciseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  substitutes            Exercise[]                  @relation("ExerciseSubstitutes")

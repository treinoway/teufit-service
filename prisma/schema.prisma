  // Adherence rates (0..100, two decimal places)
  overallAdherence Decimal @map("overall_adherence") @db.Decimal(5, 2)
  adherenceDeltaPp Decimal @map("adherence_delta_pp") @db.Decimal(5, 2)

  computedAt DateTime @map("computed_at") @db.Timestamptz(6)
  isDirty    Boolean  @default(false) @map("is_dirty")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("trainer_briefing_snapshots")
}


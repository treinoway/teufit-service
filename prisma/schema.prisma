// ─── Subscription models ──────────────────────────────────────────────────────

model SubscriptionPlan {
  id              String   @id @default(uuid()) @db.Uuid
  trainerId       String   @map("trainer_id") @db.Uuid
  name            String   @db.Text
  description     String?  @db.Text
  recurrence      String   @db.Text
  price           Decimal  @db.Decimal(10, 2)
  discountPercent Decimal? @map("discount_percent") @db.Decimal(5, 2)
  discountAmount  Decimal? @map("discount_amount") @db.Decimal(10, 2)
  billingDay      Int?     @map("billing_day")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  trainer       Trainer               @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  subscriptions StudentSubscription[]

  @@index([trainerId, deletedAt])
  @@map("subscription_plans")
}

model StudentSubscription {
  id                 String    @id @default(uuid()) @db.Uuid
  trainerId          String    @map("trainer_id") @db.Uuid
  studentId          String    @map("student_id") @db.Uuid
  planId             String    @map("plan_id") @db.Uuid
  recurrence         String    @db.Text
  price              Decimal   @db.Decimal(10, 2)
  discountPercent    Decimal?  @map("discount_percent") @db.Decimal(5, 2)
  discountAmount     Decimal?  @map("discount_amount") @db.Decimal(10, 2)
  billingDay         Int?      @map("billing_day")
  startDate          DateTime  @map("start_date") @db.Date
  status             String    @default("active") @db.Text
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?   @map("cancellation_reason") @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  trainer  Trainer               @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  student  User                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments SubscriptionPayment[]

  @@index([trainerId, status])
  @@index([studentId, status])
  @@index([planId])
  // NOTE: a partial unique index (trainer_id, student_id) WHERE status = 'active'
  // (student_subscriptions_one_active_per_pair, raw SQL in migration
  // per_trainer_active_subscription_unique) exists in the database — Prisma
  // cannot express it. A student may have one active subscription per trainer.
  @@map("student_subscriptions")
}

model SubscriptionPayment {
  id             String    @id @default(uuid()) @db.Uuid
  subscriptionId String    @map("subscription_id") @db.Uuid
  // Zero-based position of the cycle in the subscription — idempotency key for
  // the cycle generator (see subscription-cycle-service.js).
  cycleIndex     Int       @map("cycle_index")
  cycleStartDate DateTime  @map("cycle_start_date") @db.Date
  cycleEndDate   DateTime  @map("cycle_end_date") @db.Date
  dueDate        DateTime  @map("due_date") @db.Date
  amount         Decimal   @db.Decimal(10, 2)
  status         String    @default("pending") @db.Text
  paidAt         DateTime? @map("paid_at") @db.Timestamptz(6)
  // Set whenever the charge is voided (manually or by cancel/replace/unlink).
  // Survives a later late-settlement payment so reverting it returns to 'cancelled'.
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz(6)
  notes          String?   @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription StudentSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, cycleIndex])
  @@index([subscriptionId, status])
  @@index([dueDate])
  // Added for GET /trainer/dashboard: monthReceived filters status=paid within
  // a paidAt window per resolved subscriptionId list — this composite makes
  // that a range scan instead of a full scan of the trainer's paid history.
  @@index([subscriptionId, status, paidAt])
  // Added for GET /trainer/dashboard: plans.renewingSoonCount needs
  // MAX(cycleEndDate) per subscription — this composite avoids scanning
  // every payment row for each active subscription.
  @@index([subscriptionId, cycleEndDate])
  @@map("subscription_payments")
}

// ─── Trainer Briefing Snapshot ────────────────────────────────────────────────

model TrainerBriefingSnapshot {
  id        String  @id @default(uuid()) @db.Uuid
